{
  "id": "/studio",
  "name": "Horizon",
  "short_name": "Horizon",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#111827",
  "icons": [
    {
      "src": "/studio-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/studio-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/studio-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/studio.html?fileLaunch=dsp",
      "accept": {
        "application/octet-stream": [
          ".dsp"
        ]
      },
      "icons": [
        {
          "src": "/file-icons/dsp.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/viewer.html?fileLaunch=dsf",
      "accept": {
        "application/octet-stream": [
          ".dsf"
        ]
      },
      "icons": [
        {
          "src": "/file-icons/dsf.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}
