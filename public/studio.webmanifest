{
  "id": "/studio",
  "name": "DSF Studio",
  "short_name": "DSF Studio",
  "start_url": "/studio.html?room=home&source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#111827",
  "icons": [
    {
      "src": "/studio-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/studio-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/studio-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "/studio?room=home&fileLaunch=dsp",
      "name": "DSP Manuscript",
      "accept": {
        "application/vnd.dsf.project+zip": [
          ".dsp"
        ]
      },
      "launch_type": "multiple-clients",
      "icons": [
        {
          "src": "/file-icons/dsp-16.png",
          "sizes": "16x16",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsp-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsp-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsp-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsp-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsp-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsp-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "/viewer?fileLaunch=dsf",
      "name": "DSF Publication",
      "accept": {
        "application/vnd.dsf.content+zip": [
          ".dsf"
        ]
      },
      "launch_type": "multiple-clients",
      "icons": [
        {
          "src": "/file-icons/dsf-16.png",
          "sizes": "16x16",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsf-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsf-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsf-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsf-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsf-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "/file-icons/dsf-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  }
}
