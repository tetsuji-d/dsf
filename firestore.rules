rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasClaim(name) {
      return isSignedIn() && request.auth.token[name] == true;
    }

    function isAdmin() {
      return hasClaim('admin');
    }

    function isOperator() {
      return hasClaim('operator');
    }

    function isModerator() {
      return hasClaim('moderator');
    }

    function isStaff() {
      return isAdmin() || isOperator() || isModerator();
    }

    function userRecordExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userRecord(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userIsDisabled(uid) {
      return userRecordExists(uid) && userRecord(uid).status.disabled == true;
    }

    function userIsOnModerationHold(uid) {
      return userRecordExists(uid) && userRecord(uid).status.moderationHold == true;
    }

    function accountCanEdit(uid) {
      return isOwner(uid) && !userIsDisabled(uid);
    }

    function accountCanPublish(uid) {
      return accountCanEdit(uid) && !userIsOnModerationHold(uid);
    }

    function accountCanPost(uid) {
      return accountCanEdit(uid) && !userIsOnModerationHold(uid);
    }

    function projectWriteHasSupportedVersion() {
      return !request.resource.data.keys().hasAny(['version'])
        || (request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.version <= 6);
    }

    function projectVersionDoesNotRegress() {
      return !resource.data.keys().hasAny(['version'])
        || (request.resource.data.keys().hasAny(['version'])
          && request.resource.data.version is int
          && request.resource.data.version >= resource.data.version);
    }

    function projectV6AuthoringExistsAfter(uid, pid) {
      return existsAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)/authoring/current)
        && getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)/authoring/current).data.version == 6
        && getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)/authoring/current).data.projectId == pid
        && getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)/authoring/current).data.blocks is list;
    }

    function projectV6RootIsSafe(uid, pid) {
      return (request.resource.data.keys().hasAny(['version'])
          && request.resource.data.version == 6
          && request.resource.data.projectId == pid
          && request.resource.data.authoringRef == 'authoring/current'
          && request.resource.data.authoringSchemaVersion == 6
          && projectV6AuthoringExistsAfter(uid, pid))
        || ((!request.resource.data.keys().hasAny(['version'])
            || request.resource.data.version != 6)
          && !request.resource.data.keys().hasAny(['authoringRef', 'authoringSchemaVersion']));
    }

    function projectAuthoringWriteIsValid(uid, pid, authoringId) {
      return authoringId == 'current'
        && request.resource.data.version == 6
        && request.resource.data.projectId == pid
        && request.resource.data.blocks is list
        && existsAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid))
        && getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)).data.version == 6
        && getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)).data.projectId == pid
        && getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)).data.authoringRef == 'authoring/current'
        && getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)).data.authoringSchemaVersion == 6;
    }

    function planIsActive(uid) {
      return userRecordExists(uid)
        && userRecord(uid).plan.status in ['active', 'trialing']
        && (userRecord(uid).plan.currentPeriodEnd == null
          || userRecord(uid).plan.currentPeriodEnd >= request.time);
    }

    function hasPaidListingPlan(uid) {
      return planIsActive(uid)
        && (userRecord(uid).entitlements.canUseUnlimitedListing == true
          || userRecord(uid).plan.effectiveTier in ['plus', 'pro', 'business']
          || userRecord(uid).plan.tier in ['plus', 'pro', 'business', 'standard', 'enterprise']);
    }

    function hasPublicationSchedulingPlan(uid) {
      return planIsActive(uid)
        && (userRecord(uid).entitlements.canSchedulePublicExpiry == true
          || userRecord(uid).plan.effectiveTier in ['pro', 'business']
          || userRecord(uid).plan.tier in ['pro', 'business', 'enterprise']);
    }

    function validPublicationPlanSnapshot() {
      return request.resource.data.publication.planSnapshot is map
        && request.resource.data.publication.planSnapshot.keys().hasOnly([
          'tier',
          'status',
          'cancelAtPeriodEnd',
          'evaluatedAt'
        ])
        && request.resource.data.publication.planSnapshot.tier in ['free', 'plus', 'pro', 'business']
        && request.resource.data.publication.planSnapshot.status is string
        && request.resource.data.publication.planSnapshot.cancelAtPeriodEnd is bool
        && request.resource.data.publication.planSnapshot.evaluatedAt is timestamp;
    }

    function publicProjectPublicationIsValid(uid) {
      return request.resource.data.keys().hasAny(['publication'])
        && request.resource.data.publication is map
        && request.resource.data.publication.keys().hasOnly([
          'listedFrom',
          'listedUntil',
          'publicFrom',
          'publicUntil',
          'expiredAt',
          'expireReason',
          'planSnapshot'
        ])
        && request.resource.data.publication.keys().hasAll([
          'listedFrom',
          'listedUntil',
          'publicFrom',
          'publicUntil',
          'expiredAt',
          'expireReason',
          'planSnapshot'
        ])
        && request.resource.data.publication.listedFrom is timestamp
        && request.resource.data.publication.listedUntil is timestamp
        && request.resource.data.publication.publicFrom is timestamp
        && (request.resource.data.publication.publicUntil == null
            || request.resource.data.publication.publicUntil is timestamp)
        && request.resource.data.publication.expiredAt == null
        && request.resource.data.publication.expireReason == null
        && request.resource.data.publication.listedUntil > request.time
        && (request.resource.data.publication.publicUntil == null
            || request.resource.data.publication.publicUntil > request.time)
        && (request.resource.data.publication.publicUntil == null
            || request.resource.data.publication.publicUntil <= request.resource.data.publication.listedUntil)
        && (hasPublicationSchedulingPlan(uid)
            || request.resource.data.publication.publicUntil == null)
        && validPublicationPlanSnapshot()
        && (hasPaidListingPlan(uid)
            || request.resource.data.publication.listedUntil
              <= request.resource.data.publication.listedFrom + duration.value(14, 'd'));
    }

    function publicProjectExists(workId) {
      return exists(/databases/$(database)/documents/public_projects/$(workId));
    }

    function publicProjectRecord(workId) {
      return get(/databases/$(database)/documents/public_projects/$(workId)).data;
    }

    function publicReleaseCanRead(uid, workId, releaseId) {
      return publicProjectExists(workId)
        && publicProjectRecord(workId).authorUid == uid
        && publicProjectRecord(workId).workId == workId
        && publicProjectRecord(workId).releaseId == releaseId
        && publicProjectRecord(workId).dsfStatus in ['public', 'unlisted']
        && publicProjectRecord(workId).publication is map
        && publicProjectRecord(workId).publication.listedUntil > request.time
        && publicProjectRecord(workId).publication.publicFrom <= request.time
        && (publicProjectRecord(workId).publication.publicUntil == null
            || publicProjectRecord(workId).publication.publicUntil > request.time)
        && publicProjectRecord(workId).publication.expiredAt == null
        && publicProjectRecord(workId).publication.expireReason == null;
    }

    function validPlanChangeRequest(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'action',
          'requestedTier',
          'currentTier',
          'currentStatus',
          'status',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.action in ['change', 'cancel']
        && request.resource.data.requestedTier in ['free', 'plus', 'pro', 'business']
        && request.resource.data.currentTier is string
        && request.resource.data.currentStatus is string
        && request.resource.data.status == 'requested'
        && (request.resource.data.note == null || request.resource.data.note is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function defaultAuthoringRoot(uid) {
      return 'users/' + uid + '/dsp/';
    }

    function defaultPublishRoot(uid) {
      return 'users/' + uid + '/dsf/';
    }

    function validPublicHandle(handle) {
      return handle == null
        || (handle is string
            && handle.matches('^[a-z0-9_]{4,20}$')
            && !(handle in ['admin', 'administrator', 'support', 'help', 'dsf', 'horizon', 'studio', 'viewer', 'works', 'press']));
    }

    function storedPublicHandle(handle) {
      return handle is string && handle.size() > 0 ? handle : null;
    }

    function existingPublicProfileIsMap() {
      return resource.data.keys().hasAny(['publicProfile'])
        && resource.data.publicProfile is map;
    }

    function validPublicProfile(profile) {
      return profile is map
        && profile.keys().hasOnly([
          'displayName',
          'handle',
          'bio',
          'avatarUrl',
          'backgroundUrl',
          'updatedAt'
        ])
        && profile.displayName is string
        && profile.displayName.size() > 0
        && profile.displayName.size() <= 80
        && validPublicHandle(profile.handle)
        && profile.bio is string
        && profile.bio.size() <= 280
        && profile.avatarUrl is string
        && profile.avatarUrl.size() <= 2000
        && profile.backgroundUrl is string
        && profile.backgroundUrl.size() <= 2000
        && (profile.updatedAt == null || profile.updatedAt is timestamp);
    }

    function publicProfileHandleCanBeSaved(uid) {
      let existingTopLevelHandle = resource.data.keys().hasAny(['handle'])
        ? storedPublicHandle(resource.data.handle)
        : null;
      let existingHandle = existingPublicProfileIsMap()
        && resource.data.publicProfile.keys().hasAny(['handle'])
        ? storedPublicHandle(resource.data.publicProfile.handle)
        : existingTopLevelHandle;
      return request.resource.data.publicProfile.handle == existingHandle
        || (existingHandle == null
            && request.resource.data.publicProfile.handle != null
            && existsAfter(/databases/$(database)/documents/handles/$(request.resource.data.publicProfile.handle))
            && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.publicProfile.handle)).data.uid == uid);
    }

    function ownerPublicProfileWithoutHandleUpdateIsValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'handle',
          'publicProfile'
        ])
        && validPublicProfile(request.resource.data.publicProfile)
        && request.resource.data.publicProfile.handle == null
        && (!request.resource.data.keys().hasAny(['handle'])
            || request.resource.data.handle == null
            || request.resource.data.handle == '')
        && (!resource.data.keys().hasAny(['handle'])
            || resource.data.handle == null
            || resource.data.handle == '')
        && (!existingPublicProfileIsMap()
            || !resource.data.publicProfile.keys().hasAny(['handle'])
            || resource.data.publicProfile.handle == null
            || resource.data.publicProfile.handle == '');
    }

    function ownerUserCreateIsValid(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.authProvider == 'google'
        && request.resource.data.handle == null
        && validPublicProfile(request.resource.data.publicProfile)
        && request.resource.data.publicProfile.handle == null
        && request.resource.data.roles.reader == true
        && request.resource.data.roles.creator == true
        && request.resource.data.roles.admin == false
        && request.resource.data.roles.operator == false
        && request.resource.data.roles.moderator == false
        && request.resource.data.plan.tier == 'free'
        && request.resource.data.plan.effectiveTier == 'free'
        && request.resource.data.plan.status == 'active'
        && request.resource.data.plan.provider == 'none'
        && request.resource.data.plan.trialEndsAt == null
        && request.resource.data.plan.currentPeriodStart == null
        && request.resource.data.plan.currentPeriodEnd == null
        && request.resource.data.plan.cancelAtPeriodEnd == false
        && request.resource.data.plan.canceledAt == null
        && request.resource.data.plan.updatedAt == null
        && request.resource.data.billing.provider == 'none'
        && request.resource.data.billing.stripeCustomerId == null
        && request.resource.data.billing.stripeSubscriptionId == null
        && request.resource.data.billing.stripePriceId == null
        && request.resource.data.billing.stripeSubscriptionStatus == null
        && request.resource.data.billing.lastWebhookEventId == null
        && request.resource.data.billing.lastSyncedAt == null
        && request.resource.data.entitlements.canCreateProject == true
        && request.resource.data.entitlements.canUsePremiumPaper == false
        && request.resource.data.entitlements.canPublishPrivately == false
        && request.resource.data.entitlements.canUseAdvancedAnalytics == false
        && request.resource.data.entitlements.canManageLabel == false
        && request.resource.data.entitlements.canUseUnlimitedListing == false
        && request.resource.data.entitlements.canSchedulePublicExpiry == false
        && request.resource.data.status.disabled == false
        && request.resource.data.status.moderationHold == false
        && request.resource.data.storage.authoringRoot == defaultAuthoringRoot(uid)
        && request.resource.data.storage.publishRoot == defaultPublishRoot(uid)
        && request.resource.data.storage.initialized == true;
    }

    function ownerUserUpdateTouchesOnlyAllowedTopLevelKeys() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'displayName',
        'photoURL',
        'email',
        'handle',
        'publicProfile',
        'lastLoginAt',
        'roles',
        'plan',
        'billing',
        'entitlements',
        'status',
        'storage'
      ]);
    }

    function ownerProtectedUserFieldsRemainSafe(uid) {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.authProvider == resource.data.authProvider
        && request.resource.data.createdAt == resource.data.createdAt
        && validPublicProfile(request.resource.data.publicProfile)
        && request.resource.data.handle == request.resource.data.publicProfile.handle
        && publicProfileHandleCanBeSaved(uid)
        && request.resource.data.roles.reader == (resource.data.roles == null || resource.data.roles.reader == null ? true : resource.data.roles.reader)
        && request.resource.data.roles.creator == (resource.data.roles == null || resource.data.roles.creator == null ? true : resource.data.roles.creator)
        && request.resource.data.roles.admin == (resource.data.roles == null || resource.data.roles.admin == null ? false : resource.data.roles.admin)
        && request.resource.data.roles.operator == (resource.data.roles == null || resource.data.roles.operator == null ? false : resource.data.roles.operator)
        && request.resource.data.roles.moderator == (resource.data.roles == null || resource.data.roles.moderator == null ? false : resource.data.roles.moderator)
        && request.resource.data.plan.tier == (resource.data.plan == null || resource.data.plan.tier == null ? 'free' : resource.data.plan.tier)
        && request.resource.data.plan.effectiveTier == (resource.data.plan == null || resource.data.plan.effectiveTier == null ? 'free' : resource.data.plan.effectiveTier)
        && request.resource.data.plan.status == (resource.data.plan == null || resource.data.plan.status == null ? 'active' : resource.data.plan.status)
        && request.resource.data.plan.provider == (resource.data.plan == null || resource.data.plan.provider == null ? 'none' : resource.data.plan.provider)
        && request.resource.data.plan.trialEndsAt == (resource.data.plan == null || resource.data.plan.trialEndsAt == null ? null : resource.data.plan.trialEndsAt)
        && request.resource.data.plan.currentPeriodStart == (resource.data.plan == null || resource.data.plan.currentPeriodStart == null ? null : resource.data.plan.currentPeriodStart)
        && request.resource.data.plan.currentPeriodEnd == (resource.data.plan == null || resource.data.plan.currentPeriodEnd == null ? null : resource.data.plan.currentPeriodEnd)
        && request.resource.data.plan.cancelAtPeriodEnd == (resource.data.plan == null || resource.data.plan.cancelAtPeriodEnd == null ? false : resource.data.plan.cancelAtPeriodEnd)
        && request.resource.data.plan.canceledAt == (resource.data.plan == null || resource.data.plan.canceledAt == null ? null : resource.data.plan.canceledAt)
        && request.resource.data.plan.updatedAt == (resource.data.plan == null || resource.data.plan.updatedAt == null ? null : resource.data.plan.updatedAt)
        && request.resource.data.billing.provider == (resource.data.billing == null || resource.data.billing.provider == null ? 'none' : resource.data.billing.provider)
        && request.resource.data.billing.stripeCustomerId == (resource.data.billing == null || resource.data.billing.stripeCustomerId == null ? null : resource.data.billing.stripeCustomerId)
        && request.resource.data.billing.stripeSubscriptionId == (resource.data.billing == null || resource.data.billing.stripeSubscriptionId == null ? null : resource.data.billing.stripeSubscriptionId)
        && request.resource.data.billing.stripePriceId == (resource.data.billing == null || resource.data.billing.stripePriceId == null ? null : resource.data.billing.stripePriceId)
        && request.resource.data.billing.stripeSubscriptionStatus == (resource.data.billing == null || resource.data.billing.stripeSubscriptionStatus == null ? null : resource.data.billing.stripeSubscriptionStatus)
        && request.resource.data.billing.lastWebhookEventId == (resource.data.billing == null || resource.data.billing.lastWebhookEventId == null ? null : resource.data.billing.lastWebhookEventId)
        && request.resource.data.billing.lastSyncedAt == (resource.data.billing == null || resource.data.billing.lastSyncedAt == null ? null : resource.data.billing.lastSyncedAt)
        && request.resource.data.entitlements.canCreateProject == (resource.data.entitlements == null || resource.data.entitlements.canCreateProject == null ? true : resource.data.entitlements.canCreateProject)
        && request.resource.data.entitlements.canUsePremiumPaper == (resource.data.entitlements == null || resource.data.entitlements.canUsePremiumPaper == null ? false : resource.data.entitlements.canUsePremiumPaper)
        && request.resource.data.entitlements.canPublishPrivately == (resource.data.entitlements == null || resource.data.entitlements.canPublishPrivately == null ? false : resource.data.entitlements.canPublishPrivately)
        && request.resource.data.entitlements.canUseAdvancedAnalytics == (resource.data.entitlements == null || resource.data.entitlements.canUseAdvancedAnalytics == null ? false : resource.data.entitlements.canUseAdvancedAnalytics)
        && request.resource.data.entitlements.canManageLabel == (resource.data.entitlements == null || resource.data.entitlements.canManageLabel == null ? false : resource.data.entitlements.canManageLabel)
        && request.resource.data.entitlements.canUseUnlimitedListing == (resource.data.entitlements == null || resource.data.entitlements.canUseUnlimitedListing == null ? false : resource.data.entitlements.canUseUnlimitedListing)
        && request.resource.data.entitlements.canSchedulePublicExpiry == (resource.data.entitlements == null || resource.data.entitlements.canSchedulePublicExpiry == null ? false : resource.data.entitlements.canSchedulePublicExpiry)
        && request.resource.data.status.disabled == (resource.data.status == null || resource.data.status.disabled == null ? false : resource.data.status.disabled)
        && request.resource.data.status.moderationHold == (resource.data.status == null || resource.data.status.moderationHold == null ? false : resource.data.status.moderationHold)
        && request.resource.data.storage.authoringRoot == (resource.data.storage == null || resource.data.storage.authoringRoot == null ? defaultAuthoringRoot(uid) : resource.data.storage.authoringRoot)
        && request.resource.data.storage.publishRoot == (resource.data.storage == null || resource.data.storage.publishRoot == null ? defaultPublishRoot(uid) : resource.data.storage.publishRoot)
        && request.resource.data.storage.initialized == (resource.data.storage == null || resource.data.storage.initialized == null ? true : resource.data.storage.initialized);
    }

    function ownerPublicProfileUpdateIsValid(uid) {
      return ownerPublicProfileWithoutHandleUpdateIsValid()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'handle',
            'publicProfile'
          ])
          && validPublicProfile(request.resource.data.publicProfile)
          && request.resource.data.handle == request.resource.data.publicProfile.handle
          && publicProfileHandleCanBeSaved(uid));
    }

    function operatorUserUpdateTouchesOnlyAllowedTopLevelKeys() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'status',
        'plan',
        'entitlements',
        'lastLoginAt'
      ]);
    }

    function operatorUserUpdateKeepsIdentity() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.authProvider == resource.data.authProvider
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.photoURL == resource.data.photoURL
        && request.resource.data.email == resource.data.email
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.publicProfile == resource.data.publicProfile
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.storage == resource.data.storage
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function metricEventHasValidShape() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'eventType',
          'workId',
          'releaseId',
          'projectId',
          'readerUid',
          'isSignedIn',
          'sessionId',
          'language',
          'pageIndex',
          'pageCount',
          'progress',
          'reason',
          'source',
          'viewerPath',
          'referrer',
          'viewportWidth',
          'viewportHeight',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'eventType',
          'workId',
          'releaseId',
          'projectId',
          'readerUid',
          'isSignedIn',
          'sessionId',
          'language',
          'pageIndex',
          'pageCount',
          'progress',
          'reason',
          'source',
          'viewerPath',
          'referrer',
          'viewportWidth',
          'viewportHeight',
          'createdAt'
        ]);
    }

    function metricEventHasValidValues() {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.eventType in ['view_start', 'page_view', 'read_complete']
        && request.resource.data.workId is string
        && request.resource.data.workId.size() > 0
        && request.resource.data.workId.size() <= 128
        && request.resource.data.releaseId is string
        && request.resource.data.releaseId.size() <= 128
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() <= 128
        && request.resource.data.readerUid is string
        && request.resource.data.readerUid == (isSignedIn() ? request.auth.uid : '')
        && request.resource.data.isSignedIn == isSignedIn()
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.sessionId.size() <= 96
        && request.resource.data.language is string
        && request.resource.data.language.size() > 0
        && request.resource.data.language.size() <= 16
        && request.resource.data.pageIndex is int
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount > 0
        && request.resource.data.pageIndex >= 0
        && request.resource.data.pageIndex < request.resource.data.pageCount
        && request.resource.data.progress is number
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 1
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 64
        && request.resource.data.source == 'shared'
        && request.resource.data.viewerPath is string
        && request.resource.data.viewerPath.size() <= 256
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 512
        && request.resource.data.viewportWidth is int
        && request.resource.data.viewportWidth >= 0
        && request.resource.data.viewportWidth <= 10000
        && request.resource.data.viewportHeight is int
        && request.resource.data.viewportHeight >= 0
        && request.resource.data.viewportHeight <= 10000
        && request.resource.data.createdAt == request.time;
    }

    function validMetricEvent() {
      return metricEventHasValidShape() && metricEventHasValidValues();
    }

    function reviewHasValidShape() {
      return request.resource.data.keys().hasOnly([
          'reviewId',
          'workId',
          'releaseId',
          'projectId',
          'authorUid',
          'readerUid',
          'readerName',
          'goodCount',
          'badCount',
          'body',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'reviewId',
          'workId',
          'releaseId',
          'projectId',
          'authorUid',
          'readerUid',
          'readerName',
          'goodCount',
          'badCount',
          'body',
          'status',
          'createdAt',
          'updatedAt'
        ]);
    }

    function reviewHasValidValues(workId, reviewId) {
      return request.resource.data.reviewId == reviewId
        && request.resource.data.workId == workId
        && request.resource.data.releaseId is string
        && request.resource.data.releaseId.size() <= 128
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() <= 128
        && request.resource.data.authorUid is string
        && request.resource.data.authorUid.size() <= 128
        && request.resource.data.readerUid == request.auth.uid
        && request.resource.data.readerName is string
        && request.resource.data.readerName.size() <= 80
        && request.resource.data.goodCount is int
        && request.resource.data.goodCount == 0
        && request.resource.data.badCount is int
        && request.resource.data.badCount == 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validReviewCreate(workId, reviewId) {
      return isSignedIn()
        && accountCanPost(request.auth.uid)
        && reviewHasValidShape()
        && reviewHasValidValues(workId, reviewId);
    }

    function validReviewStaffUpdate() {
      return isStaff()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['published', 'hidden', 'removed']
        && request.resource.data.updatedAt == request.time;
    }

    function priorReviewGoodCount() {
      return resource.data.keys().hasAny(['goodCount']) ? resource.data.goodCount : 0;
    }

    function priorReviewBadCount() {
      return resource.data.keys().hasAny(['badCount']) ? resource.data.badCount : 0;
    }

    function validReviewReactionAggregateUpdate() {
      return isSignedIn()
        && accountCanPost(request.auth.uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['goodCount', 'badCount', 'updatedAt'])
        && request.resource.data.goodCount is int
        && request.resource.data.goodCount >= 0
        && request.resource.data.goodCount <= priorReviewGoodCount() + 1
        && request.resource.data.goodCount >= priorReviewGoodCount() - 1
        && request.resource.data.badCount is int
        && request.resource.data.badCount >= 0
        && request.resource.data.badCount <= priorReviewBadCount() + 1
        && request.resource.data.badCount >= priorReviewBadCount() - 1
        && request.resource.data.updatedAt == request.time;
    }

    function validReviewReactionShape(uid) {
      return request.resource.data.keys().hasOnly([
          'workId',
          'reviewId',
          'uid',
          'reaction',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'workId',
          'reviewId',
          'uid',
          'reaction',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.reaction in ['good', 'bad'];
    }

    function validReviewReactionCreate(workId, reviewId, uid) {
      return accountCanPost(uid)
        && validReviewReactionShape(uid)
        && request.resource.data.workId == workId
        && request.resource.data.reviewId == reviewId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validReviewReactionUpdate() {
      return isSignedIn()
        && accountCanPost(request.auth.uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reaction', 'updatedAt'])
        && request.resource.data.reaction in ['good', 'bad']
        && request.resource.data.updatedAt == request.time;
    }

    // ユーザー正本
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid) && ownerUserCreateIsValid(uid);
      allow update: if (isOwner(uid)
                        && ownerPublicProfileUpdateIsValid(uid))
                    || (isOwner(uid)
                        && ownerUserUpdateTouchesOnlyAllowedTopLevelKeys()
                        && ownerProtectedUserFieldsRemainSafe(uid))
                    || (isAdmin())
                    || (isOperator()
                        && operatorUserUpdateTouchesOnlyAllowedTopLevelKeys()
                        && operatorUserUpdateKeepsIdentity());
      allow delete: if isAdmin();

      // ユーザーごとのプロジェクト
      match /projects/{pid} {
        allow read: if isOwner(uid);
        allow create: if accountCanEdit(uid)
                      && projectWriteHasSupportedVersion()
                      && projectV6RootIsSafe(uid, pid);
        allow update: if accountCanEdit(uid)
                      && projectWriteHasSupportedVersion()
                      && projectVersionDoesNotRegress()
                      && projectV6RootIsSafe(uid, pid);
        allow delete: if accountCanEdit(uid)
                      && !existsAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid)/authoring/current);
        allow read: if resource.data.dsfStatus in ['public', 'unlisted'];

        // 完全なProject v6 authoring sourceは公開可能なrootへ置かない。
        // Flow本文・翻訳・レイアウトはowner専用の子documentに保存する。
        match /authoring/{authoringId} {
          allow read: if isOwner(uid);
          allow create: if accountCanEdit(uid)
                        && projectAuthoringWriteIsValid(uid, pid, authoringId);
          allow update: if accountCanEdit(uid)
                        && projectAuthoringWriteIsValid(uid, pid, authoringId)
                        && projectVersionDoesNotRegress();
          allow delete: if accountCanEdit(uid)
                        && authoringId == 'current'
                        && !existsAfter(/databases/$(database)/documents/users/$(uid)/projects/$(pid));
        }
      }

      // 読者向けの恒久作品IDと発行履歴
      match /works/{workId} {
        allow read: if isOwner(uid) || isStaff();
        allow create, update, delete: if accountCanEdit(uid);

        match /releases/{releaseId} {
          allow read: if isOwner(uid) || isStaff() || publicReleaseCanRead(uid, workId, releaseId);
          allow create, update, delete: if accountCanEdit(uid);
        }
      }

      // 読者ごとのしおり。ドキュメントIDは workId。
      match /bookmarks/{workId} {
        allow read: if isOwner(uid);
        allow create, update: if accountCanEdit(uid)
                              && request.resource.data.workId == workId;
        allow delete: if accountCanEdit(uid);
      }

      match /planChangeRequests/{requestId} {
        allow read: if isOwner(uid) || isStaff();
        allow create: if accountCanEdit(uid) && validPlanChangeRequest(uid);
        allow update, delete: if isStaff();
      }
    }

    match /handles/{handle} {
      allow read: if true;
      allow create: if isSignedIn()
        && validPublicHandle(handle)
        && request.resource.data.keys().hasOnly(['handle', 'uid', 'createdAt'])
        && request.resource.data.handle == handle
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /public_projects/{pid} {
      allow read: if true;
      allow create, update: if (accountCanPublish(request.auth.uid)
                              && request.resource.data.authorUid == request.auth.uid
                              && publicProjectPublicationIsValid(request.auth.uid))
                            || isAdmin()
                            || isOperator();
      allow delete: if (isSignedIn()
                        && resource.data.authorUid == request.auth.uid
                        && !userIsDisabled(request.auth.uid))
                    || isAdmin()
                    || isOperator();
    }

    match /metric_events/{eventId} {
      allow create: if validMetricEvent();
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /billing_events/{eventId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /reviews/{workId} {
      allow read, write: if false;

      match /items/{reviewId} {
        allow read: if resource.data.status == 'published'
                    || (isSignedIn() && resource.data.readerUid == request.auth.uid)
                    || isStaff();
        allow create: if validReviewCreate(workId, reviewId);
        allow update: if validReviewStaffUpdate()
                      || validReviewReactionAggregateUpdate();
        allow delete: if isStaff()
                      || (isSignedIn() && resource.data.readerUid == request.auth.uid);

        match /reactions/{uid} {
          allow read: if isOwner(uid) || isStaff();
          allow create: if validReviewReactionCreate(workId, reviewId, uid);
          allow update: if validReviewReactionUpdate();
          allow delete: if isOwner(uid) || isStaff();
        }
      }
    }
  }
}
