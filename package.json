{
  "name": "dsf-studio-pro",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:staging": "vite build --mode staging",
    "deploy:staging": "npm run deploy:pages:staging",
    "deploy:prod": "node scripts/deploy-prod-safe.js",
    "deploy:firebase:rules:staging": "firebase deploy --project staging --only firestore:rules",
    "deploy:firebase:rules:prod": "firebase deploy --project prod --only firestore:rules",
    "deploy:firebase:storage-rules:staging": "firebase deploy --project staging --only storage:rules",
    "deploy:firebase:storage-rules:prod": "firebase deploy --project prod --only storage:rules",
    "deploy:firebase:staging": "npm run deploy:firebase:rules:staging",
    "deploy:firebase:prod": "npm run deploy:firebase:rules:prod",
    "deploy:firebase:hosting:staging": "npm run build:staging && firebase deploy --project staging --only hosting",
    "deploy:firebase:hosting:prod": "npm run build && firebase deploy --project prod --only hosting",
    "preview:staging": "npm run build:staging && npx wrangler pages dev dist --port 8788",
    "preview:firebase:staging": "npm run build:staging && firebase hosting:channel:deploy staging-review --project staging",
    "test:firebase": "node scripts/verify-firebase.js",
    "verify:flow-foundation": "node scripts/verify-flow-foundation.js",
    "verify:flow-model": "node scripts/verify-flow-model.js",
    "verify:flow-project-model": "node scripts/verify-flow-project-model.js",
    "verify:project-persistence": "node scripts/verify-project-persistence.js",
    "verify:flow-preview": "node scripts/verify-flow-preview.js",
    "verify:flow-incremental": "node scripts/verify-flow-incremental.js",
    "verify:flow-page-projection": "node scripts/verify-flow-page-projection.js",
    "verify:flow-authoring": "node scripts/verify-flow-authoring.js",
    "verify:flow-multilingual-authoring": "node scripts/verify-flow-multilingual-authoring.js",
    "deploy:prod:check": "node scripts/deploy-prod-safe.js --check-only",
    "deploy:prod:safe": "node scripts/deploy-prod-safe.js",
    "deploy:pages": "node scripts/deploy-prod-safe.js --skip-firebase",
    "deploy:pages:staging": "npm run build:staging && npx wrangler pages deploy dist --project-name dsf-studio --branch staging",
    "deploy:cf:prod": "node scripts/deploy-prod-safe.js --skip-firebase",
    "deploy:cf:staging": "npm run deploy:pages:staging",
    "dev:pages": "npx wrangler pages dev dist --port 8788",
    "dev:cf": "npm run dev:pages",
    "claims:set": "node scripts/set-custom-claims.js"
  },
  "devDependencies": {
    "firebase-admin": "^13.3.0",
    "firebase-tools": "^15.5.1",
    "vite": "^5.0.0",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "file-saver": "^2.0.5",
    "firebase": "^10.7.1",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1"
  }
}
